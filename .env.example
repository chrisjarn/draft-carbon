# ===========================================
# Carbon Workforce Planner - Environment Variables
# ===========================================
# Copy this file to the appropriate location and fill in real values.
#
# Backend (apps/server/.env):
#   BETTER_AUTH_SECRET, BETTER_AUTH_URL, CORS_ORIGIN, DATABASE_URL, OPENAI_API_KEY
#
# Frontend (apps/web/.env):
#   VITE_SERVER_URL
# ===========================================

# --- Backend (apps/server/.env) ---

# Secret key for Better Auth session signing (generate a random string)
BETTER_AUTH_SECRET=your-secret-key-here

# The URL where the backend server is running
BETTER_AUTH_URL=http://localhost:3000

# Allowed CORS origin (the frontend URL)
CORS_ORIGIN=http://localhost:3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# OpenAI API key for AI chat features (required)
OPENAI_API_KEY=sk-...

# --- Frontend (apps/web/.env) ---

# The URL of the backend API server
VITE_SERVER_URL=http://localhost:3000
