# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL when you add a Postgres plugin to your project.
# For local dev, paste your connection string here.
DATABASE_URL=postgres://user:password@localhost:5432/carbon_wfp

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_with_32_byte_random_hex_string

# The public URL of your deployed app (no trailing slash)
# Railway gives you this after first deploy — e.g. https://carbon-wfp.up.railway.app
BETTER_AUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated allowed origins for CORS (your Railway URL goes here in prod)
TRUSTED_ORIGINS=http://localhost:3000

# Set to 'true' to prevent new signups via the API (recommended for production)
DISABLE_SIGNUP=false
