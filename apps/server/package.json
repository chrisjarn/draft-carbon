{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.41",
		"@carbon-wfp/api": "workspace:*",
		"@carbon-wfp/auth": "workspace:*",
		"@carbon-wfp/db": "workspace:*",
		"@carbon-wfp/env": "workspace:*",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"ai": "^6.0.116",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.1",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@carbon-wfp/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.16.5",
		"typescript": "catalog:"
	}
}
