{
	"extends": "@carbon-wfp/config/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun"],
		"rootDirs": ["."],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["src"],
	"exclude": ["template-overview-main"]
}
