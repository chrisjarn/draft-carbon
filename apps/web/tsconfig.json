{
	"extends": "@carbon-wfp/config/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"rootDirs": ["."],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noUnusedLocals": false,
		"noUnusedParameters": false
	}
}
